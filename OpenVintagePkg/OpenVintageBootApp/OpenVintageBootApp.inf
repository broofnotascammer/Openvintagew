[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = OpenVintageBootApp
  FILE_GUID                      = 8F5A720C-4A2B-4261-9C7E-2B6E3241C901
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.2
  ENTRY_POINT                    = UefiMain

[Sources]
  OpenVintageBootApp.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  OpenVintagePkg/OpenVintagePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib
  OpenVintageLogLib
  OpenVintageCoreLib
  OvLoggerLib
  OvCoreLib
  OvConfigLib
  OvMemoryLib
  OvHardwareLib
  OvModuleLib
  OvResolverLib
  OvSchedulerLib

[Protocols]
  gOpenVintageHalProtocolGuid       ## SOMETIMES_CONSUMES
  gEfiPciIoProtocolGuid             ## CONSUMES
  gEfiBlockIoProtocolGuid           ## CONSUMES
  gEfiGraphicsOutputProtocolGuid    ## CONSUMES
