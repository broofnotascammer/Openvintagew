##

[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = OpenVintagePkg
  PACKAGE_UNI_FILE               = OpenVintagePkg.uni
  PACKAGE_GUID                   = 5B3E2C34-F851-4017-91F9-03B9B478D1F0
  PACKAGE_VERSION                = 0.20

[Includes]
  Include

[LibraryClasses]
  ## @libraryclass  Provides OpenVintage Core services and runtime initialization
  OpenVintageCoreLib|Include/Library/OpenVintageCoreLib.h

  ## @libraryclass  Provides OpenVintage Diagnostic and Serial Logging services
  OpenVintageLogLib|Include/Library/OpenVintageLogLib.h

  ## @libraryclass  Enhanced Multi-level Logger with Serial & Subsystem Tagging
  OvLoggerLib|Include/Library/OvLoggerLib.h

  ## @libraryclass  Configuration storage, profile management and feature flags
  OvConfigLib|Include/Library/OvConfigLib.h

  ## @libraryclass  Memory allocation, tracking and leak detection abstraction
  OvMemoryLib|Include/Library/OvMemoryLib.h

  ## @libraryclass  Hardware discovery and topology inspection
  OvHardwareLib|Include/Library/OvHardwareLib.h

  ## @libraryclass  Subsystem module lifecycle management
  OvModuleLib|Include/Library/OvModuleLib.h

  ## @libraryclass  Workload resolution decision framework
  OvResolverLib|Include/Library/OvResolverLib.h

  ## @libraryclass  Task scheduling and resource budgeting
  OvSchedulerLib|Include/Library/OvSchedulerLib.h

  ## @libraryclass  Unified Core runtime coordinator
  OvCoreLib|Include/Library/OvCoreLib.h

  ## @libraryclass  Graphics Intermediate Representation (OVIR-GPU)
  OvirGpuLib|Include/Library/OvirGpuLib.h

  ## @libraryclass  GPU Capability Manager and Feature Detection
  OvGpuCapabilityLib|Include/Library/OvGpuCapabilityLib.h

  ## @libraryclass  Graphics API Adapters (Vulkan, OpenGL, Metal, DirectX)
  OvirAdaptersLib|Include/Library/OvirAdaptersLib.h

  ## @libraryclass  Shader Representation, Ingestion, Validation & Cache
  OvirShaderLib|Include/Library/OvirShaderLib.h

  ## @libraryclass  Pipeline Abstraction, State Management & Cache
  OvirPipelineLib|Include/Library/OvirPipelineLib.h

  ## @libraryclass  Resource System (Buffers, Textures, Samplers, GPU Memory)
  OvirResourceLib|Include/Library/OvirResourceLib.h

  ## @libraryclass  Performance Measurement & Telemetry Infrastructure
  OvirPerfLib|Include/Library/OvirPerfLib.h

  ## @libraryclass  Graphics Workload Resolver Bridge
  OvirResolverLib|Include/Library/OvirResolverLib.h

  ## @libraryclass  CPU Intermediate Representation Core
  OvirCpuLib|Include/Library/OvirCpuLib.h

  ## @libraryclass  Multi-Architecture Instruction Decoders (ARM64, x86)
  OvirCpuDecoderLib|Include/Library/OvirCpuDecoderLib.h

  ## @libraryclass  CPU IR Non-Speculative Optimizer Passes
  OvirCpuOptimizerLib|Include/Library/OvirCpuOptimizerLib.h

  ## @libraryclass  Target Native Machine Code Generators
  OvirCpuBackendLib|Include/Library/OvirCpuBackendLib.h

  ## @libraryclass  Translation Block Cache & Version Management
  OvirCpuCacheLib|Include/Library/OvirCpuCacheLib.h

  ## @libraryclass  Dynamic Just-In-Time Compilation Pipeline
  OvirCpuJitLib|Include/Library/OvirCpuJitLib.h

  ## @libraryclass  CPU Scheduler Integration Bridge
  OvirCpuSchedulerLib|Include/Library/OvirCpuSchedulerLib.h

  ## @libraryclass  Phase 5 Measurable Performance Management
  OvPerfSystemLib|Include/Library/OvPerfSystemLib.h

  ## @libraryclass  Phase 5 Dynamic Resource Allocation & Platform Constraints
  OvResourceManagerLib|Include/Library/OvResourceManagerLib.h

  ## @libraryclass  Phase 5 Unified Multi-Tier Cache & Invalidation
  OvUnifiedCacheLib|Include/Library/OvUnifiedCacheLib.h

  ## @libraryclass  Phase 5 Compatibility Matrix & Silicon Quirks
  OvCompatibilityLib|Include/Library/OvCompatibilityLib.h

  ## @libraryclass  Phase 5 Unified Diagnostics & Telemetry Auditing
  OvDiagnosticsLib|Include/Library/OvDiagnosticsLib.h

  ## @libraryclass  Phase 5 Reproducible Empirical Benchmarking
  OvBenchmarkLib|Include/Library/OvBenchmarkLib.h

[Guids]
  gOpenVintagePkgTokenSpaceGuid  = { 0x3F58A74E, 0x2914, 0x40DF, { 0x88, 0x31, 0x81, 0x17, 0x72, 0x6F, 0x9C, 0x32 } }

[Protocols]
  ## OpenVintage Platform Identification Protocol
  gOpenVintagePlatformProtocolGuid = { 0x8A923891, 0x5981, 0x47E1, { 0x93, 0x8B, 0x22, 0x9A, 0x73, 0xA1, 0x6E, 0x50 } }

  ## OpenVintage Hardware Abstraction Layer Protocol
  gOpenVintageHalProtocolGuid      = { 0x1F744E82, 0x7462, 0x4F49, { 0x82, 0x90, 0x3D, 0x49, 0xA7, 0x01, 0x83, 0x21 } }

[PcdsFixedAtBuild]
  gOpenVintagePkgTokenSpaceGuid.PcdOpenVintageBannerEnable|TRUE|BOOLEAN|0x00010001
  gOpenVintagePkgTokenSpaceGuid.PcdOpenVintageVersionString|L"OpenVintage Firmware & Runtime v0.2.0 (X64)"|VOID*|0x00010002
  gOpenVintagePkgTokenSpaceGuid.PcdOpenVintageTargetArchitecture|L"Legacy Intel Core / Xeon (2006-2015)"|VOID*|0x00010003
  gOpenVintagePkgTokenSpaceGuid.PcdOpenVintageLogLevel|0x00000003|UINT32|0x00010004
